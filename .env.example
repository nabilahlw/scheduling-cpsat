# Salin file ini jadi .env lalu isi nilainya. 
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/teacher_scheduling
# Buat dengan: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-teks-acak
TOKEN_EXPIRE_MINUTES=480
TRAVEL_BUFFER=30
MAX_SOLVE_SECONDS=10
PBKDF2_ITERATIONS=600000